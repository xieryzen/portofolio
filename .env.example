# ==========================================================
#  Portfolio CMS - konfigurasi aplikasi
#  Salin file ini menjadi .env lalu sesuaikan nilainya.
# ==========================================================

APP_NAME="Portfolio"
APP_ENV=production
APP_DEBUG=false
# Ganti dengan string acak panjang (minimal 32 karakter)
APP_KEY=ubah-string-ini-dengan-acak-minimal-32-karakter

# ------------------------------------------------------------------
# Port & host: DIKOSONGKAN untuk Pterodactyl.
# Pterodactyl otomatis menyediakan SERVER_PORT / SERVER_IP.
# Diisi hanya jika menjalankan manual (mis. php -S lokal).
# ------------------------------------------------------------------
APP_HOST=
APP_PORT=8080

# ------------------------------------------------------------------
# Database
# sqlite  = tanpa konfigurasi tambahan, cocok untuk Pterodactyl
# mysql   = isi kredensial di bawah (egg biasanya membuatnya otomatis)
# ------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite

# DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portfolio
DB_USERNAME=portfolio
DB_PASSWORD=

# ------------------------------------------------------------------
# Akun owner/admin pertama (dibuat otomatis saat pertama kali jalan)
# WAJIB diganti sebelum situs dibuka untuk umum — lewat Admin > Pengaturan,
# atau isi nilainya di sini SEBELUM instalasi pertama.
# ------------------------------------------------------------------
OWNER_NAME="Pemilik Portfolio"
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=Owner12345!

# Izinkan pengunjung membuat akun user
ALLOW_REGISTRATION=true

# Batas ukuran upload gambar (MB)
MAX_UPLOAD_MB=6

# Batas ukuran file rilis/unduhan per project (MB, maks 500)
RELEASE_MAX_MB=50

# Batas ukuran berkas ZIP cadangan saat restore (MB)
BACKUP_MAX_MB=200

# Warna aksen default (bisa diubah dari panel admin)
ACCENT_COLOR=#6d8bff

# Set true bila situs dijalankan di balik reverse proxy HTTPS
TRUST_PROXY=true

# ------------------------------------------------------------------
# Notifikasi pesan kontak (opsional — kosongkan bila tidak dipakai)
# ------------------------------------------------------------------
# Telegram: buat bot lewat @BotFather, isi token + chat id kamu.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Webhook JSON (Discord/Slack/n8n/Zapier).
NOTIFY_WEBHOOK_URL=
# Email tujuan + SMTP (kosongkan SMTP_HOST untuk memakai mail()).
NOTIFY_EMAIL_TO=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls

# ---- Optimasi gambar (WebP) --------------------------------------------
# Konversi otomatis gambar upload ke WebP bila ekstensi GD tersedia.
IMAGE_WEBP=true
IMAGE_MAX_WIDTH=1600
IMAGE_WEBP_QUALITY=82

# ---- CV (PDF) ----------------------------------------------------------
CV_MAX_MB=10
